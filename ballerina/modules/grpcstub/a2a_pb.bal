@protobuf:Descriptor {value: A2A_DESC}
public type GetTaskRequest record {|
    string tenant = "";
    string id = "";
    int history_length?;
|};

isolated function isValidGettaskrequest(GetTaskRequest r) returns boolean {
    int _history_lengthCount = 0;
    if r?.history_length !is () {
        _history_lengthCount += 1;
    }
    if _history_lengthCount > 1 {
        return false;
    }
    return true;
}

isolated function setGetTaskRequest_HistoryLength(GetTaskRequest r, int history_length) {
    r.history_length = history_length;
}

